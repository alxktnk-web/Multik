{
  "name": "multik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lighttable:combined && node scripts/lighttable-stage.mjs",
    "build:lighttable": "tsc --noEmit && vite build --config vite.lighttable.config.ts",
    "test:lighttable": "vitest run src/lighttable",
    "test:lighttable:browser": "node scripts/lighttable-check.mjs",
    "test:lighttable:build": "npm run build:lighttable && node scripts/lighttable-build-check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lab:shot": "node scripts/lab-shot.mjs",
    "build:artifact": "npm run build && vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:pwa": "npm run build && node scripts/pwa-check.mjs",
    "test:lighttable:data": "node scripts/lighttable-data-check.mjs",
    "test:lighttable:workspace": "node scripts/lighttable-workspace-check.mjs",
    "test:lighttable:pro": "node scripts/lighttable-pro-check.mjs",
    "test:lighttable:export": "node scripts/lighttable-export-check.mjs",
    "build:lighttable:combined": "npm run build:lighttable && node scripts/lighttable-assemble.mjs",
    "test:lighttable:pwa": "node scripts/lighttable-pwa-check.mjs",
    "test:lighttable:cache": "node scripts/lighttable-cache-check.mjs",
    "build:classic": "tsc --noEmit && vite build",
    "test:lighttable:onehand": "node scripts/lighttable-onehand-check.mjs",
    "test:lighttable:gestures": "node scripts/lighttable-gesture-v2-check.mjs",
    "test:lighttable:editor": "node scripts/lighttable-editor-check.mjs",
    "test:lighttable:levels": "node scripts/lighttable-levels-gpu-check.mjs",
    "test:lighttable:adaptive": "node scripts/lighttable-adaptive-check.mjs",
    "test:lighttable:favorites": "node scripts/lighttable-favorites-check.mjs",
    "test:lighttable:import": "node scripts/lighttable-import-v3-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
